# Server
PORT=8787
DATA_DIR=./data

# App defaults
APP_NAME=CC Companion
USER_NAME=You
ASSISTANT_NAME=Assistant
GROUP_NAME=Workgroup
AGENT_MENTION=assistant
AUTO_REPLY_GROUP=false

# Optional OpenAI-compatible agent.
# Leave OPENAI_API_KEY empty to use the built-in mock agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ── Built-in Claude Code bridge (no API key) ────────────────────────────────
# Use your local Claude Code CLI as the backend and keep your Claude
# subscription, MCP tools, and extended thinking. Run `npm run bridge` in a
# second terminal, then point the provider settings above at the bridge:
#
#   OPENAI_API_KEY=bridge                     # any non-empty value; the bridge ignores it
#   OPENAI_BASE_URL=http://127.0.0.1:8788/v1
#   OPENAI_MODEL=claude-code
#
# The bridge reads the settings below from this same .env file.
# SECURITY: the bridge is an unauthenticated proxy to your Claude subscription.
# Keep BRIDGE_HOST=127.0.0.1 unless you put your own auth + TLS in front of it.
# (It reuses APP_AUTH_TOKEN below to post console events to a protected app.)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8788
# Where the bridge reaches the app to post live thinking/tool events.
APP_URL=http://127.0.0.1:8787
# The claude executable (default: found on PATH).
CLAUDE_BIN=claude
# Optional: pin a model / load extra MCP servers for the bridge's CLI sessions.
CLAUDE_MODEL=
CLAUDE_MCP_CONFIG=
# Mode: 'interactive' (default) drives a real interactive CLI in a pty and reads the
# session transcript, so extended thinking is shown in chat + Console (Linux/WSL only).
# 'print' uses headless `claude -p` — faster and cross-platform, but no thinking blocks.
BRIDGE_MODE=interactive
# Interactive mode only: passed through as `claude --permission-mode <mode>`
# (e.g. plan / acceptEdits / default). Leave empty to use your existing Claude Code
# permission config. If a tool needs approval that isn't pre-allowed, the turn hangs
# waiting at the terminal — pre-configure an allowlist by running `claude` once first.
BRIDGE_PERMISSION_MODE=
# Session continuity: 'resume' keeps one long-lived Claude Code session (context
# persists across turns and bridge restarts); 'fresh' starts a new session each
# restart. To start a brand-new conversation, stop the bridge and delete
# <DATA_DIR>/bridge-session.json.
BRIDGE_SESSION_MODE=resume
# Max time for a single Claude turn before the bridge gives up (ms).
BRIDGE_TIMEOUT_MS=300000

# Conversation context sent to the OpenAI-compatible agent (0 disables).
# The history window is trimmed with a persisted anchor that only advances in
# batches (max -> keep), so the prompt prefix stays byte-stable across turns
# and provider-side prompt caching can actually hit.
# Claude Code / cc-connect mode keeps context in the CC session itself; these
# settings do not apply there.
CHAT_CONTEXT_MAX_MESSAGES=40
CHAT_CONTEXT_KEEP_MESSAGES=24

# Optional semantic memory recall. Set an OpenAI-compatible /embeddings model
# (e.g. text-embedding-3-small) to recall memories by meaning; leave empty to
# use the built-in lexical recall. EMBEDDING_DIMENSIONS is passed through only
# when set (your provider must support the parameter).
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Auto memory extraction: after every N fresh user messages a model is asked
# to pull out stable facts worth remembering; results are deduped against the
# existing library and saved as AI-authored memories. 0 disables.
MEMORY_EXTRACT_EVERY=8

# Extraction runs on the main OPENAI_* model by default. To use a separate
# (small, cheap) model just for extraction, set these — each falls back to the
# matching OPENAI_* value. Setting EXTRACT_* also enables auto extraction in
# Claude Code / cc-connect mode, where no main API key is configured.
EXTRACT_MODEL=
EXTRACT_BASE_URL=
EXTRACT_API_KEY=

# How many reference-document chunks (记忆-资料库) to inject per turn. 0 disables.
DOC_RECALL_LIMIT=3

# Optional real forge adapter.
# If unset, /forge only performs companion-local history cleanup.
# If set, /forge POSTs the cleaned history plan here first and only commits
# the local history segment after the adapter returns 2xx JSON.
FORGE_ADAPTER_URL=
FORGE_ADAPTER_TOKEN=
FORGE_ADAPTER_TIMEOUT_MS=120000

# Optional quota adapter for /quota.
# The app does not know Claude/cc-connect subscription limits by itself.
# If set, /quota POSTs a small status request here and records the JSON result
# as a console event.
QUOTA_ADAPTER_URL=
QUOTA_ADAPTER_TOKEN=
QUOTA_ADAPTER_TIMEOUT_MS=30000

# Access token. WITHOUT it, read + send stay open to anyone who can reach the app,
# and destructive routes (delete a message / clear a conversation) are REFUSED (403).
# Set a token to enable delete/clear, and always set one before exposing beyond localhost.
APP_AUTH_TOKEN=

# Access from your phone anywhere (no same-WiFi needed): set TUNNEL=quick to
# open a free Cloudflare quick tunnel on startup and log the public HTTPS URL
# (terminal + console tab). Requires the `cloudflared` binary on PATH; the URL
# changes on every restart. Set APP_AUTH_TOKEN before sharing the URL — without it,
# anyone with the link can read all your messages and use your AI (delete/clear are refused).
TUNNEL=

# Optional heartbeat: let the assistant occasionally reach out on its own.
# Only meaningful with a configured OpenAI-compatible model (see OPENAI_* above);
# the mock agent just posts an occasional demo line. Off by default.
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MINUTES=90
# Skip a heartbeat if the last chat message is newer than this (don't interrupt an active chat).
HEARTBEAT_MIN_IDLE_MINUTES=45
# Quiet window (local server hours, 24h). No proactive messages during [start, end).
HEARTBEAT_QUIET_START=0
HEARTBEAT_QUIET_END=8
